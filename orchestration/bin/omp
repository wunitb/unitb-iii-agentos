#!/usr/bin/env bash
set -euo pipefail

: "${UNITB_FLEET_ROLE:?}"
: "${UNITB_FLEET_ID:?}"
: "${UNITB_FLEET_AGENT_RUNTIME:?}"
: "${UNITB_FLEET_AGENT_HOME:?}"
: "${UNITB_FLEET_WORKTREE:?}"
: "${UNITB_FLEET_SOCKET_HOST:?}"
: "${UNITB_CREDENTIAL_SOCKET_HOST:?}"
: "${UNITB_FLEET_CONFIG:?}"
: "${UNITB_ASSIGNMENT_PROMPT:?}"
: "${UNITB_FLEET_TOKEN_FILE:?}"
: "${UNITB_NETWORK_HOSTS:?}"
: "${UNITB_NETWORK_RESOLV:?}"
: "${UNITB_NETWORK_NFT:?}"
: "${UNITB_STAGED_OMP:?}"
: "${UNITB_STAGED_TOOLCHAIN:?}"
: "${UNITB_STAGED_BUN:?}"
: "${UNITB_HERDR_SOCKET_HOST:?}"
: "${HERDR_PANE_ID:?}"

HOST_HOME=$HOME
auth_broker_token=$(<"$UNITB_FLEET_TOKEN_FILE")
BWRAP=/usr/local/libexec/unitb-fleet/bwrap
PASTA=/usr/local/libexec/unitb-fleet/pasta
SESSIONS_DIR="$UNITB_FLEET_AGENT_RUNTIME/sessions"

bwrap_args=(
  --die-with-parent
  --new-session
  --unshare-user
  --unshare-pid
  --unshare-uts
  --unshare-ipc
  --clearenv
  --tmpfs /
  --dir /usr
  --ro-bind /usr /usr
  --symlink usr/bin /bin
  --symlink usr/sbin /sbin
  --symlink usr/lib /lib
  --dir /etc
  --dir /etc/ssl
  --ro-bind /etc/ssl/certs /etc/ssl/certs
  --ro-bind /etc/passwd /etc/passwd
  --ro-bind /etc/group /etc/group
  --ro-bind /etc/nsswitch.conf /etc/nsswitch.conf
  --ro-bind "$UNITB_NETWORK_HOSTS" /etc/hosts
  --ro-bind "$UNITB_NETWORK_RESOLV" /etc/resolv.conf
  --dev /dev
  --proc /proc
  --tmpfs /tmp
  --dir /run
  --tmpfs /run/user
  --dir "$HOST_HOME"
  --dir "$UNITB_FLEET_AGENT_RUNTIME"
  --bind "$UNITB_FLEET_AGENT_HOME" "$UNITB_FLEET_AGENT_HOME"
  --bind "$PI_CODING_AGENT_DIR" "$PI_CODING_AGENT_DIR"
  --bind "$SESSIONS_DIR" "$SESSIONS_DIR"
  --ro-bind "$UNITB_STAGED_TOOLCHAIN" "$UNITB_STAGED_TOOLCHAIN"
  --ro-bind "$UNITB_FLEET_CONFIG" "$UNITB_FLEET_CONFIG"
  --ro-bind "$UNITB_FLEET_TOKEN_FILE" "$UNITB_FLEET_TOKEN_FILE"
  --ro-bind "$UNITB_ASSIGNMENT_PROMPT" "$UNITB_ASSIGNMENT_PROMPT"
  --ro-bind "$UNITB_FLEET_SOCKET_HOST" /run/dispatcher.sock
  --ro-bind "$UNITB_CREDENTIAL_SOCKET_HOST" /run/credential.sock
  --ro-bind "$UNITB_HERDR_SOCKET_HOST" /run/herdr.sock
  --ro-bind "$UNITB_NETWORK_NFT" "$UNITB_NETWORK_NFT"
  --chdir "$UNITB_FLEET_WORKTREE"
  --setenv HOME "$UNITB_FLEET_AGENT_HOME"
  --setenv USER "${USER:-wunitb}"
  --setenv LOGNAME "${LOGNAME:-wunitb}"
  --setenv PATH "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$HOST_HOME/.cargo/bin"
  --setenv TERM "${TERM:-xterm-256color}"
  --setenv LANG "${LANG:-C.UTF-8}"
  --setenv SSH_AUTH_SOCK ""
  --setenv PI_CODING_AGENT_DIR "$PI_CODING_AGENT_DIR"
  --setenv OMP_AUTH_BROKER_URL "http://127.0.0.1:8765"
  --setenv OMP_AUTH_BROKER_TOKEN "$auth_broker_token"
  --setenv UNITB_FLEET_ROLE "$UNITB_FLEET_ROLE"
  --setenv UNITB_FLEET_ID "$UNITB_FLEET_ID"
  --setenv UNITB_FLEET_CONFIG "$UNITB_FLEET_CONFIG"
  --setenv UNITB_FLEET_REPO_ROOT "$UNITB_FLEET_REPO_ROOT"
  --setenv UNITB_FLEET_WORKTREE "$UNITB_FLEET_WORKTREE"
  --setenv UNITB_FLEET_TOKEN_FILE "$UNITB_FLEET_TOKEN_FILE"
  --setenv UNITB_FLEET_SOCKET /run/dispatcher.sock
  --setenv HERDR_SOCKET_PATH /run/herdr.sock
  --setenv HERDR_ENV "1"
  --setenv HERDR_PANE_ID "$HERDR_PANE_ID"
  --setenv GIT_AUTHOR_NAME "$GIT_AUTHOR_NAME"
  --setenv GIT_AUTHOR_EMAIL "$GIT_AUTHOR_EMAIL"
  --setenv GIT_COMMITTER_NAME "$GIT_COMMITTER_NAME"
  --setenv GIT_COMMITTER_EMAIL "$GIT_COMMITTER_EMAIL"
  --setenv RUSTUP_HOME "$HOST_HOME/.rustup"
  --setenv CARGO_HOME "$UNITB_FLEET_AGENT_HOME/.cargo"
)

if [[ -d "$HOST_HOME/.rustup" ]]; then
  bwrap_args+=(--dir "$HOST_HOME/.rustup" --ro-bind "$HOST_HOME/.rustup" "$HOST_HOME/.rustup")
fi
if [[ -d "$HOST_HOME/.cargo/bin" ]]; then
  bwrap_args+=(--dir "$HOST_HOME/.cargo" --dir "$HOST_HOME/.cargo/bin" --ro-bind "$HOST_HOME/.cargo/bin" "$HOST_HOME/.cargo/bin")
fi

if [[ "$UNITB_FLEET_ROLE" == "team" ]]; then
  bwrap_args+=(--bind "$UNITB_FLEET_WORKTREE" "$UNITB_FLEET_WORKTREE")
else
  bwrap_args+=(--ro-bind "$UNITB_FLEET_WORKTREE" "$UNITB_FLEET_WORKTREE")
fi

exec /usr/bin/python3 "$UNITB_FLEET_REPO_ROOT/orchestration/bin/omp-supervisor.py" "$PASTA" \
  --quiet \
  --foreground \
  --config-net \
  --ipv4-only \
  --no-map-gw \
  --tcp-ports none \
  --udp-ports none \
  --tcp-ns none \
  --udp-ns none \
  -- \
  /bin/bash -c '
    /usr/sbin/nft -f "$1"
    shift
    exec "$@"
  ' unitb-fleet "$UNITB_NETWORK_NFT" \
  "$BWRAP" "${bwrap_args[@]}" -- \
  /bin/bash -c '
    /usr/bin/socat TCP-LISTEN:8765,bind=127.0.0.1,reuseaddr,fork UNIX-CONNECT:/run/credential.sock 2>/dev/null &
    exec "$1" "$2/dist/cli.js" "${@:3}"
  ' unitb-fleet "$UNITB_STAGED_BUN" "$UNITB_STAGED_OMP" "$@"
