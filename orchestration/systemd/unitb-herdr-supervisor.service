[Unit]
Description=UnitB Herdr persistent supervisor
After=network.target

[Service]
Type=simple
Environment=HERDR_SESSION=tldrsoc
ExecStart=%h/.bun/bin/bun @REPO_ROOT@/orchestration/herdr-supervisor.ts
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
