[Unit]
Description=UnitB OMP fleet Main control-plane agent
After=unitb-herdr-supervisor.service unitb-fleet-dispatcher.service
Requires=unitb-herdr-supervisor.service unitb-fleet-dispatcher.service

[Service]
Type=oneshot
WorkingDirectory=@REPO_ROOT@
ExecStart=%h/.bun/bin/bun @REPO_ROOT@/orchestration/dispatcher.ts launch-main
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
