[Unit]
Description=UnitB deterministic OMP fleet dispatcher
After=network.target unitb-herdr-supervisor.service unitb-omp-auth-broker.service
Wants=unitb-herdr-supervisor.service unitb-omp-auth-broker.service

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
ExecStart=%h/.bun/bin/bun @REPO_ROOT@/orchestration/dispatcher.ts serve
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
