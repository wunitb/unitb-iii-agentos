{
  "version": 4,
  "session": "tldrsoc",
  "workspaceLabel": "unitb-iii-agentos",
  "repo": "wunitb/unitb-iii-agentos",
  "runtimeDir": "../unitb-iii-agentos-runtime/fleet",
  "worktreeDir": "../unitb-iii-agentos-worktrees",
  "maxTeams": 2,
  "credentialProxy": {
    "bind": "127.0.0.1:49137",
