    "allowedHostsByProvider": {
      "anthropic": ["api.anthropic.com"],
      "openai-codex": ["chatgpt.com", "chat.openai.com", "api.openai.com"]
    }
  },
  "main": {
    "model": "openai-codex/gpt-5.6-sol",
    "credentialId": 1
  },
  "teams": [
    {
      "id": "TEAM-01",
      "model": "anthropic/claude-opus-5",
      "credentialId": 4
    },
    {
      "id": "TEAM-02",
      "model": "openai-codex/gpt-5.6-terra",
      "credentialId": 3
    }
  ],
  "reviewer": {
    "id": "Reviewer",
    "routes": {
      "TEAM-01": {
        "model": "openai-codex/gpt-5.6-terra",
        "credentialId": 3
      },
      "TEAM-02": {
        "model": "anthropic/claude-opus-5",
        "credentialId": 4
      }
    }
  }
