# AgentOS dotenv template.
#
#   install -m 600 .env.example .env
#
# `agentos up`, `agentos start` and `scripts/dev-up.sh` all load the active
# `.env`. dev-up.sh accepts exactly the names declared here plus the env keys
# declared by `integrations/*.toml`, so this file is the allowlist: adding a
# name here is what makes it usable. `scripts/env-contract.test.ts` fails when a
# name here has no consumer, and when a secret the workers read is missing.

# --- machine identity -------------------------------------------------------
# Required by every protected HTTP route (crates/http-adapter/src/lib.rs).
# Leave it empty: `agentos up`, `agentos start` and `agentos onboard` generate a
# 32-byte key here on first run and never overwrite an existing value.
AGENTOS_API_KEY=
# Audit-chain HMAC key (workers/security). Set one before production; the
# worker otherwise falls back to a well-known development default.
AUDIT_HMAC_KEY=

# --- model providers (workers/llm-router) -----------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=

# Local OpenAI-compatible proxy. AGENTOS_DEFAULT_PROVIDER/MODEL only take effect
# while CODEX_PROXY_API_KEY is set; with it empty, unqualified requests route to
# Anthropic and need ANTHROPIC_API_KEY. `agentos doctor` prints the result.
CODEX_PROXY_BASE_URL=http://127.0.0.1:8317/v1
CODEX_PROXY_API_KEY=
AGENTOS_DEFAULT_PROVIDER=codex
AGENTOS_DEFAULT_MODEL=gpt-5.6-sol
AGENTOS_E2E_MODEL=gpt-5.6-sol

# --- runtime ----------------------------------------------------------------
III_URL=ws://localhost:49134
AGENTOS_API_URL=http://localhost:3111
AGENTOS_WORKSPACE=.
WORKSPACE_ROOT=
AGENTOS_WORKFLOWS_DIR=
AGENTOS_INTEGRATIONS_DIR=
HANDS_DIR=
NODE_ENV=development

# --- channel credentials ----------------------------------------------------
# Read by the channel workers through vault::get with an environment fallback,
# and checked by workers/agent-core/src/main.rs::channel_secrets.
BLUESKY_HANDLE=
BLUESKY_PASSWORD=
DISCORD_BOT_TOKEN=
# Ed25519 public key from the Discord application page; the interactions route
# is not registered without it (every inbound request is signature-checked).
DISCORD_PUBLIC_KEY=
LINKEDIN_TOKEN=
LINKEDIN_CLIENT_SECRET=
MASTODON_INSTANCE=
MASTODON_TOKEN=
MATRIX_HOMESERVER=
MATRIX_TOKEN=
# Application-service hs_token; the AS transaction route is not registered
# without it.
MATRIX_HS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_SECRET=
REDDIT_REFRESH_TOKEN=
SIGNAL_API_URL=
SIGNAL_PHONE=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_ALLOWED_SERVICE_URLS=
# Outgoing-webhook HMAC secret (the `Authorization: HMAC ...` scheme); Bot
# Connector traffic is verified by JWT against TEAMS_APP_ID instead.
TEAMS_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_TOKEN=
TWITCH_BOT_USER_ID=
TWITCH_EVENTSUB_SECRET=
WEBEX_TOKEN=
# Webhook secret configured on the Webex webhook (X-Spark-Signature HMAC-SHA1);
# the inbound route is not registered without it.
WEBEX_WEBHOOK_SECRET=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Email channel (workers/channel-email).
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- memworkr runtime (optional, see INSTALL_STACK.md) ----------------------
# Read by the memworkr binary that scripts/memworkr-sync.sh installs. Values
# stay empty here; production values belong in your own `.env`.
III_WS_URL=
MEMWORKR_RUNTIME_ROOT=
MEMWORKR_PRODUCTION=
MEMWORKR_REQUIRE_CALLER=
MEMWORKR_INSTANCE_ID=
MEMWORKR_DB=
MEMWORKR_MAX_IN_FLIGHT=
MEMWORKR_EXPENSIVE_MAX_IN_FLIGHT=
MEMWORKR_MEMORY_SOFT_LIMIT_MIB=
MEMWORKR_REQUEST_TIMEOUT_MS=
MEMWORKR_SHUTDOWN_GRACE_MS=
MEMWORKR_CANDIDATE_RECONCILE_MAX=
MEMWORKR_AUTH_TRIGGER=
